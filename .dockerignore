# Secrets and developer-only environment files must never enter an image build context.
# Docker sends the complete non-ignored context to its daemon, so protect nested
# variants too. Approved templates are not build inputs for either staging image.
.env
.env.*
**/.env
**/.env.*
*.env
*.env.*
**/*.env
**/*.env.*
*.secret
*.secrets
**/*.secret
**/*.secrets
*.pem
*.key
*.p12
*.pfx

# Host/build artefacts and repository metadata are not required by either staging image.
.git
node_modules
backend/target
docs
documentation
coverage
*.log
*.tsbuildinfo

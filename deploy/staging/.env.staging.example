# Copie para um arquivo FORA do repositório, por exemplo /opt/zerith/staging.env.
# Nunca preencha ou versione este arquivo de exemplo com valores reais.

# DNS público já apontado para o IPv4 da VPS; sem protocolo ou barra final.
STAGING_DOMAIN=staging.example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=zerith
POSTGRES_USER=zerith
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# JWT HS256: segredo aleatório com pelo menos 32 bytes; não reutilizar senha de usuário.
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRATION_MINUTES=480

# Exclusivos do ambiente de demonstração sintético.
ZERITH_DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD
ZERITH_DEVICE_KEY=CHANGE_ME_DEVICE_KEY

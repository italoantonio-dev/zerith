FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json postcss.config.js tailwind.config.ts ./
COPY public ./public
COPY src ./src
# Keep browser-visible configuration deliberately limited to the same-origin API.
ENV VITE_API_URL=/api/v1
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/staging/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/docs/ /usr/share/nginx/html/zehit/
EXPOSE 8080
